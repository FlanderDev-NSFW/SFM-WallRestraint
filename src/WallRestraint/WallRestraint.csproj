<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(RepoRoot)build\SfmMod.props" />

  <PropertyGroup>
    <AssemblyName>WallRestraint</AssemblyName>
    <RootNamespace>WallRestraint</RootNamespace>
    <Version>1.1.0</Version>
    <Description>WallRestraint - wall-mounted restraints for SecretFlasherManaka (BepInEx IL2CPP)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.UI"><HintPath>$(SfmInterop)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(SfmInterop)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <!-- The model, exported from TheWall.blend by tools/export_model.py (see README). -->
    <EmbeddedResource Include="assets\wallrestraint.wrm" LogicalName="WallRestraint.assets.wallrestraint.wrm" />
  </ItemGroup>

  <!-- Compile the shared SfmKit sources into this DLL (remove this line if you do not use it). -->
  <Import Project="$(RepoRoot)build\SfmKit.props" />
  <Import Project="$(RepoRoot)build\SfmMod.targets" />
</Project>
